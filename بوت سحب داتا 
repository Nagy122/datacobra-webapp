async def handle_admin_input(update: Update, context: ContextTypes.DEFAULT_TYPE,
                              text: str, state: dict):
    global VODAFONE_CASH_NUMBER
    user   = update.effective_user
    action = state.get("action")

    def back_btn(cb): return [[InlineKeyboardButton("🔙 رجوع", callback_data=cb, style="danger")]]

    if action == "broadcast_message":
        del admin_state[user.id]
        success_count = 0
        fail_count    = 0
        wait_msg = await update.message.reply_text("📤 جاري إرسال الرسالة الجماعية...")
        for uid in list(bot_users):
            if uid == user.id:
                continue
            try:
                await context.bot.copy_message(
                    chat_id=uid,
                    from_chat_id=update.message.chat_id,
                    message_id=update.message.message_id
                )
                success_count += 1
            except Exception:
                fail_count += 1
        await wait_msg.edit_text(
            f"✅ <b>تم إرسال الرسالة الجماعية</b>\n\n"
            f"✅ تم الإرسال: {success_count} مستخدم\n"
            f"❌ فشل الإرسال: {fail_count} مستخدم",
            reply_markup=InlineKeyboardMarkup(back_btn("admin_panel")),
            parse_mode="HTML"
        )

    elif action == "add_subadmin":
        uid_str = text.strip()
        if not uid_str.isdigit():
            await update.message.reply_text("❌ يجب إرسال رقم ID صحيح (أرقام فقط):")
            return
        uid = int(uid_str)
        if uid in ADMIN_IDS:
            await update.message.reply_text(
                "⚠️ هذا المستخدم أدمن رئيسي بالفعل!",
                reply_markup=InlineKeyboardMarkup(back_btn("admin_manage_subadmin"))
            )
        elif uid in SUB_ADMIN_IDS:
            await update.message.reply_text(
                "⚠️ هذا المستخدم مضاف كأدمن مساعد بالفعل!",
                reply_markup=InlineKeyboardMarkup(back_btn("admin_manage_subadmin"))
            )
        else:
            SUB_ADMIN_IDS.append(uid)
            del admin_state[user.id]
            await update.message.reply_text(
                f"✅ تمت إضافة الأدمن المساعد!\n\n🆔 الـ ID: <code>{uid}</code>",
                reply_markup=InlineKeyboardMarkup(back_btn("admin_manage_subadmin")),
                parse_mode="HTML"
            )
        return

    elif action == "change_cash_number":
        new_num = text.strip()
        if not new_num.startswith("01") or len(new_num) != 11 or not new_num.isdigit():
            await update.message.reply_text("❌ رقم غير صحيح! أرسل 11 رقم يبدأ بـ 01:")
            return
        VODAFONE_CASH_NUMBER = new_num
        del admin_state[user.id]
        await update.message.reply_text(
            f"✅ تم تغيير رقم فودافون كاش إلى: <code>{VODAFONE_CASH_NUMBER}</code>",
            reply_markup=InlineKeyboardMarkup(back_btn("admin_panel")),
            parse_mode="HTML"
        )

    elif action == "deliver_order":
        oid   = state["order_id"]
        order = pending_orders.get(oid)
        if not order:
            del admin_state[user.id]
            await update.message.reply_text("❌ الطلب غير موجود!")
            return
        data_text = text.strip()
        order["status"] = "delivered"
        del admin_state[user.id]
        # إرسال البيانات للمستخدم
        try:
            await context.bot.send_message(
                chat_id=order["user_id"],
                text=(
                    f"✅ <b>تم تسليم طلبك #{oid}</b>\n\n"
                    f"📦 الخدمة: {order['service_label']}\n\n"
                    f"📋 <b>البيانات:</b>\n{data_text}"
                ),
                parse_mode="HTML"
            )
            await update.message.reply_text(
                f"✅ تم إرسال البيانات للمستخدم بنجاح!\n\nالطلب #{oid} مكتمل.",
                reply_markup=InlineKeyboardMarkup(back_btn("admin_panel"))
            )
        except Exception as e:
            await update.message.reply_text(f"❌ فشل الإرسال للمستخدم: {e}")

    elif action == "edit_btn_details":
        btn_key = state["btn_key"]
        buttons_config[btn_key]["details"] = text.strip()
        del admin_state[user.id]
        await update.message.reply_text(
            f"✅ تم تحديث تفاصيل زر {buttons_config[btn_key]['label']}!",
            reply_markup=InlineKeyboardMarkup(back_btn(f"mngbtn_{btn_key}"))
        )

    elif action == "edit_btn_link":
        btn_key = state["btn_key"]
        buttons_config[btn_key]["link"] = "" if text.strip() == "-" else text.strip()
        del admin_state[user.id]
        await update.message.reply_text(
            f"✅ تم تحديث لينك زر {buttons_config[btn_key]['label']}!",
            reply_markup=InlineKeyboardMarkup(back_btn(f"mngbtn_{btn_key}"))
        )

    elif action == "edit_btn_price":
        btn_key = state["btn_key"]
        buttons_config[btn_key]["price"] = "" if text.strip() == "-" else text.strip()
        del admin_state[user.id]
        await update.message.reply_text(
            f"✅ تم تحديث سعر زر {buttons_config[btn_key]['label']}!",
            reply_markup=InlineKeyboardMarkup(back_btn(f"mngbtn_{btn_key}"))
        )

    elif action == "edit_dev_name":
        developer_info["name"] = text.strip()
        del admin_state[user.id]
        await update.message.reply_text(
            "✅ تم تحديث اسم المطور!",
            reply_markup=InlineKeyboardMarkup(back_btn("admin_manage_dev"))
        )

    elif action == "edit_dev_bio":
        developer_info["bio"] = text.strip()
        del admin_state[user.id]
        await update.message.reply_text(
            "✅ تم تحديث نبذة المطور!",
            reply_markup=InlineKeyboardMarkup(back_btn("admin_manage_dev"))
        )

    elif action == "edit_dev_photo":
        if text.strip() == "-":
            developer_info["photo_id"] = ""
            del admin_state[user.id]
            await update.message.reply_text(
                "✅ تم إزالة صورة المطور!",
                reply_markup=InlineKeyboardMarkup(back_btn("admin_manage_dev"))
            )
        else:
            await update.message.reply_text("📸 أرسل الصورة مباشرة كصورة تليجرام، أو أرسل - للإزالة:")

    elif action == "add_gift_name":
        admin_state[user.id] = {"action": "add_gift_price", "name": text}
        await update.message.reply_text("💰 أرسل سعر الهدية:")

    elif action == "add_gift_price":
        admin_state[user.id]["price"]  = text
        admin_state[user.id]["action"] = "add_gift_link"
        await update.message.reply_text("🔗 أرسل لينك الأكونت (أو - لتركه فارغاً):")

    elif action == "add_gift_link":
        link  = "" if text.strip() == "-" else text.strip()
        name  = admin_state[user.id]["name"]
        price = admin_state[user.id]["price"]
        products_data["gifts"].append({"name": name, "price": price, "link": link})
        del admin_state[user.id]
        await update.message.reply_text(
            f"✅ تمت الإضافة!\n\n🎁 {name}\n💰 {price}\n🔗 {link or 'لا يوجد'}",
            reply_markup=InlineKeyboardMarkup(back_btn("admin_manage_gifts"))
        )

    elif action == "edit_gift":
        step = state.get("step")
        idx  = state.get("index")

        if step == "name":
            if text.strip() != "-":
                products_data["gifts"][idx]["name"] = text.strip()
            admin_state[user.id]["step"] = "price"
            await update.message.reply_text(
                f"💰 أرسل السعر الجديد (أو - للإبقاء على: {products_data['gifts'][idx]['price']}):"
            )

        elif step == "price":
            if text.strip() != "-":
                products_data["gifts"][idx]["price"] = text.strip()
            admin_state[user.id]["step"] = "link"
            current = products_data["gifts"][idx].get("link") or "لا يوجد"
            await update.message.reply_text(
                f"🔗 أرسل اللينك الجديد (أو - للإبقاء على: {current}):"
            )

        elif step == "link":
            if text.strip() != "-":
                val = text.strip()
                products_data["gifts"][idx]["link"] = "" if val.lower() == "none" else val
            del admin_state[user.id]
            g = products_data["gifts"][idx]
            await update.message.reply_text(
                f"✅ تم التعديل!\n\n🎁 {g['name']}\n💰 {g['price']}\n🔗 {g.get('link') or 'لا يوجد'}",
                reply_markup=InlineKeyboardMarkup(back_btn("admin_manage_gifts"))
            )

def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.PHOTO, photo_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, text_handler))

    logger.info("✅ البوت شغال!")
    print("✅ البوت شغال!")
    app.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()
