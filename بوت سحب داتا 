async def handle_user_state(update: Update, context: ContextTypes.DEFAULT_TYPE, text: str, ustate: dict):
    user   = update.effective_user
    action = ustate.get("action")

    if action == "cash_check_waiting_number":
        target = text.strip()
        if not target.startswith("01") or len(target) != 11 or not target.isdigit():
            await update.message.reply_text(
                "❌ رقم غير صحيح!\nيجب أن يبدأ بـ 01 ويتكون من 11 رقم فقط.\n\nأرسل الرقم مرة أخرى:"
            )
            return
        del user_state[user.id]
        wait_msg = await update.message.reply_text("🔍 جاري البحث في فودافون كاش...")
        success, token, msisdn = cash_login(CASH_CHECK_PHONE, CASH_CHECK_PASSWORD)
        if not success:
            await wait_msg.edit_text("❌ خطأ في الاتصال بالخادم. حاول مرة أخرى لاحقاً.")
            return
        name = search_wallet_owner(token, msisdn, target)
        if name:
            result_text = (
                f"✅ <b>تم العثور على صاحب المحفظة</b>\n\n"
                f"📱 الرقم: <code>{target}</code>\n"
                f"👤 الاسم: <b>{name}</b>\n\n"
                f"✅ هذا الرقم مسجل في فودافون كاش ولديه محفظة نشطة."
            )
        else:
            result_text = (
                f"❌ <b>لم يتم العثور على نتيجة</b>\n\n"
                f"📱 الرقم: <code>{target}</code>\n\n"
                f"⚠️ إما أن الرقم غير مسجل في فودافون كاش، أو المحفظة غير مفعلة."
            )
        keyboard = [[InlineKeyboardButton("🔍 بحث عن رقم آخر", callback_data="cashcheck_again", style="primary")]]
        await wait_msg.edit_text(result_text, reply_markup=InlineKeyboardMarkup(keyboard), parse_mode="HTML")

    elif action == "waiting_transfer_phone":
        # المستخدم بعت رقم الهاتف اللي حوّل منه
        phone = text.strip()
        if not phone.startswith("01") or len(phone) != 11 or not phone.isdigit():
            await update.message.reply_text("❌ رقم غير صحيح! أرسل رقم 11 خانة يبدأ بـ 01:")
            return
        ustate["transfer_phone"] = phone
        ustate["action"]         = "waiting_target_number"
        user_state[user.id]      = ustate
        keyboard = [[InlineKeyboardButton("❌ إلغاء", callback_data="cancel_user_state", style="danger")]]
        await update.message.reply_text(
            f"✅ تم تسجيل رقم التحويل: <code>{phone}</code>\n\n"
            "📱 الآن أرسل <b>رقم الهاتف المراد سحب بياناته</b>:",
            reply_markup=InlineKeyboardMarkup(keyboard),
            parse_mode="HTML"
        )

    elif action == "waiting_target_number":
        # المستخدم بعت رقم الهاتف المراد سحب بياناته
        target = text.strip()
        if not target.startswith("01") or len(target) != 11 or not target.isdigit():
            await update.message.reply_text("❌ رقم غير صحيح! أرسل رقم 11 خانة يبدأ بـ 01:")
            return
        ustate["target_number"] = target
        ustate["action"]        = "waiting_transfer_screenshot"
        user_state[user.id]     = ustate
        keyboard = [[InlineKeyboardButton("❌ إلغاء", callback_data="cancel_user_state", style="danger")]]
