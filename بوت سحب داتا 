        # إرسال الطلب للمطور/المالك
        order_text = (
            f"🛒 <b>طلب شراء جديد #{oid}</b>\n\n"
            f"👤 الاسم: {user.full_name}\n"
            f"🆔 اليوزر: @{user.username or 'لا يوجد'}\n"
